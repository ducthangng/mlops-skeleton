# Copy to .env (gitignored) and fill in. scripts/lib.sh loads it for every make target.
# Classic PAT scopes: repo, write:packages (includes read:packages).
GITHUB_USER=ducthangng
GITHUB_PAT=

# LLM provider key (OpenAI). `make llm-key` puts it in Secret llm-upstream; never in Git.
# Provider URL and model names are not secret: they live in mlops-gitops values-<env>.yaml.
UPSTREAM_API_KEY=

# Optional overrides (defaults shown)
# GITOPS_DIR=../mlops-gitops
# GITOPS_REVISION=main
# APP_BRANCH=main
