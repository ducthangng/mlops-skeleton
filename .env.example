# Copy to .env (gitignored) and fill in. scripts/lib.sh loads it for every make target.
# Classic PAT scopes: repo, write:packages (includes read:packages).
GITHUB_USER=ducthangng
GITHUB_PAT=

# LLM provider keys for the AI gateway (all optional; providers without a key are hidden in the UI,
# the offline mock provider always works). `make llm-key` puts them in Secret llm-providers; never in Git.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# GITOPS_DIR=../mlops-gitops
# APP_DIR=../custom-ai-gateway
# GITOPS_REVISION=main
# APP_BRANCH=main
